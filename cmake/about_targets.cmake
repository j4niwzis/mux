# find_package records miss libraries reused through targets that already
# exist. Read those edges from the link graph as well, including aliases.
function(mux_about_targets out directory)
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(imported DIRECTORY "${directory}" PROPERTY IMPORTED_TARGETS)
  list(APPEND targets ${imported})
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    mux_about_targets(nested "${child}")
    list(APPEND targets ${nested})
  endforeach()
  list(REMOVE_DUPLICATES targets)
  set(${out} "${targets}" PARENT_SCOPE)
endfunction()

function(mux_about_target_owner out target ports)
  get_target_property(alias "${target}" ALIASED_TARGET)
  if(alias)
    set(target "${alias}")
  endif()
  foreach(port IN LISTS ports)
    cme_port_field(exports "${port}" TARGETS)
    cme_port_field(imports "${port}" IMPORT_TARGETS)
    foreach(import IN LISTS imports)
      string(REGEX REPLACE "^[^=]*=" "" imported "${import}")
      list(APPEND exports "${imported}")
    endforeach()
    foreach(export IN LISTS exports)
      if(NOT TARGET "${export}")
        continue()
      endif()
      get_target_property(alias "${export}" ALIASED_TARGET)
      if(NOT alias)
        set(alias "${export}")
      endif()
      if(alias STREQUAL target)
        set(${out} "${port}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
  endforeach()
  # Source projects commonly expose several targets beyond the port's
  # advertised entry point. The most specific source tree owns them.
  get_target_property(imported "${target}" IMPORTED)
  get_target_property(source "${target}" SOURCE_DIR)
  set(owner "")
  set(longest 0)
  if(NOT imported AND source)
    foreach(port IN LISTS ports)
      get_property(tree GLOBAL PROPERTY CME_TREE_${port})
      if(NOT tree)
        continue()
      endif()
      cmake_path(IS_PREFIX tree "${source}" NORMALIZE inside)
      string(LENGTH "${tree}" length)
      if(inside AND length GREATER longest)
        set(owner "${port}")
        set(longest "${length}")
      endif()
    endforeach()
  endif()
  set(${out} "${owner}" PARENT_SCOPE)
endfunction()

function(mux_about_link_dependencies ports)
  mux_about_targets(targets "${CMAKE_SOURCE_DIR}")
  foreach(target IN LISTS targets)
    mux_about_target_owner(owner "${target}" "${ports}")
    set_property(GLOBAL PROPERTY MUX_ABOUT_TARGET_${target} "${owner}")
  endforeach()
  foreach(target IN LISTS targets)
    get_property(owner GLOBAL PROPERTY MUX_ABOUT_TARGET_${target})
    if(NOT owner)
      continue()
    endif()
    foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
      get_target_property(links "${target}" "${property}")
      # Installation-only interfaces do not describe the running build.
      string(REGEX REPLACE "\\$<INSTALL_INTERFACE:[^>]*>" "" links "${links}")
      string(REGEX REPLACE "\\$<[A-Za-z0-9_]+:" ";" links "${links}")
      # Extract target names from ordinary links and generator wrappers
      # such as LINK_ONLY, BUILD_INTERFACE and TARGET_NAME_IF_EXISTS.
      string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_:.+-]*" linked "${links}")
      foreach(link IN LISTS linked)
        if(NOT TARGET "${link}")
          continue()
        endif()
        get_target_property(alias "${link}" ALIASED_TARGET)
        if(alias)
          set(link "${alias}")
        endif()
        get_property(dependency GLOBAL PROPERTY MUX_ABOUT_TARGET_${link})
        if(dependency AND NOT dependency STREQUAL owner)
          set_property(GLOBAL APPEND PROPERTY MUX_ABOUT_LINKS_${owner} "${dependency}")
        endif()
      endforeach()
    endforeach()
  endforeach()
endfunction()
