diff --git a/cmake/mesonproject.cmake b/cmake/mesonproject.cmake
index f94fc92..b9d7f54 100644
--- a/cmake/mesonproject.cmake
+++ b/cmake/mesonproject.cmake
@@ -60,11 +60,35 @@ function(cme_meson_machine_file port out_file out_kind)
   string(APPEND lines "\n[binaries]\n")
 
   if(CMAKE_C_COMPILER)
-    cme_meson_list(value "${CMAKE_C_COMPILER}")
+    set(command "${CMAKE_C_COMPILER}")
+    if(CMAKE_C_COMPILER_ARG1)
+      separate_arguments(arguments NATIVE_COMMAND "${CMAKE_C_COMPILER_ARG1}")
+      list(APPEND command ${arguments})
+    endif()
+    # A clang driver remains a host compiler until its target is said.
+    # Android's sysroot and ARM flags do not select the target by themselves.
+    if(CMAKE_C_COMPILER_TARGET)
+      list(APPEND command "--target=${CMAKE_C_COMPILER_TARGET}")
+    endif()
+    if(CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN)
+      list(APPEND command "--gcc-toolchain=${CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN}")
+    endif()
+    cme_meson_list(value ${command})
     string(APPEND lines "c = ${value}\n")
   endif()
   if(CMAKE_CXX_COMPILER)
-    cme_meson_list(value "${CMAKE_CXX_COMPILER}")
+    set(command "${CMAKE_CXX_COMPILER}")
+    if(CMAKE_CXX_COMPILER_ARG1)
+      separate_arguments(arguments NATIVE_COMMAND "${CMAKE_CXX_COMPILER_ARG1}")
+      list(APPEND command ${arguments})
+    endif()
+    if(CMAKE_CXX_COMPILER_TARGET)
+      list(APPEND command "--target=${CMAKE_CXX_COMPILER_TARGET}")
+    endif()
+    if(CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN)
+      list(APPEND command "--gcc-toolchain=${CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN}")
+    endif()
+    cme_meson_list(value ${command})
     string(APPEND lines "cpp = ${value}\n")
   endif()
   if(CMAKE_AR)
@@ -95,7 +119,7 @@ function(cme_meson_machine_file port out_file out_kind)
   if(cme_c_tuning)
     separate_arguments(c_args UNIX_COMMAND "${cme_c_tuning}")
   endif()
-  if(CMAKE_CXX_FLAGS)
+  if(cme_cxx_tuning)
     separate_arguments(cpp_args UNIX_COMMAND "${cme_cxx_tuning}")
   endif()
   # What linking here takes, which is not the same as what compiling takes.
